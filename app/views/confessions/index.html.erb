<%= form_with model: @confession, url: confessions_path, local: true, class: "mb-6" do |form| %>
  <div class="mb-4">
    <%= form.text_area :body, maxlength: 500, placeholder: "Your anonymous confession...", class: "w-full p-2 border rounded" %>
  </div>
  <div>
    <%= form.submit "Post", class: "bg-blue-500 text-white px-4 py-2 rounded" %>
  </div>
<% end %>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
  <% @confessions.each do |confession| %>
    <div class="p-4 bg-white rounded shadow">
      <p class="mb-2"><%= confession.body %></p>
      <div class="flex gap-4">
        <% %w[like hug laugh].each do |emoji| %>
          <form method="post" action="/confessions/<%= confession.id %>/reactions">
            <%= hidden_field_tag :reaction_type, emoji %>
            <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
            <button class="hover:scale-110 transition-transform">
              <%= emoji %>
            </button>
          </form>
        <% end %>
      </div>
    </div>
  <% end %>
</div>